APP_NAME=PushpThreadsAPI
APP_ENV=development
API_PREFIX=/api/v1

# SQL Server connection
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=PushpThreads
DB_DRIVER=SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true
# Set DB_TRUSTED_CONNECTION=false and provide credentials for SQL authentication.
DB_TRUSTED_CONNECTION=true
DB_USER=
DB_PASSWORD=

# Azure SQL example (replace the values above when using Azure SQL Database):
# DB_SERVER=your-server.database.windows.net
# DB_PORT=1433
# DB_DRIVER=ODBC Driver 18 for SQL Server
# DB_ENCRYPT=true
# DB_TRUST_SERVER_CERTIFICATE=false
# DB_TRUSTED_CONNECTION=false
# DB_USER=your-sql-login
# DB_PASSWORD=your-sql-password
